{
  "rules": {
    ".read": true,

    "$localId": {

      "COMISIONES": {

        "MOVIMIENTOS": {
          "$opId": {
            ".write": "!data.exists()",
            ".validate": "newData.hasChildren(['tipo','ts'])"
          }
        },

        "TOTALES": {
          ".write": true,
          "totalAcumuladoCentavos": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0"
          },
          "totalPagadoCentavos": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0"
          },
          "saldoPendienteCentavos": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0"
          },
          "migracionVersion": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$otroTotal": { ".validate": true }
        },

        "REGISTRO": {
          ".write": true,
          "$ventaKey": {
            ".validate": "root.child($localId).child('COMISIONES').child('TOTALES').child('migracionVersion').val() < 1 || newData.hasChild('opId') || !newData.hasChildren(['comisionGenerada'])"
          }
        },

        "PAGOS":            { ".write": true },
        "PAGOS_PENDIENTES": { ".write": true },
        "$otroComision":    { ".write": true }
      },

      "PEDIDOS":   { ".write": true, ".indexOn": "fechacaja" },
      "MOSTRADOR": { ".write": true, ".indexOn": "fechacaja" },
      "$otro":     { ".write": true }
    }
  }
}
