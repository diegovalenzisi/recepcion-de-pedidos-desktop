# ============================================================
# Configuración del backend MercadoPago
# Copiar este archivo como backend.env en la carpeta de datos
# de la app: C:\Users\TU_USUARIO\AppData\Roaming\recepcion-de-pedidos-desktop\
# ============================================================

# --- MercadoPago ---
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...tu-token-de-produccion...

# --- Firebase Admin SDK ---
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@tu-proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://tu-proyecto-default-rtdb.firebaseio.com

# --- Local ID del negocio (debe coincidir con el LOCAL_ID de la app web) ---
LOCAL_ID=40508022

# --- Puerto del servidor (no cambiar salvo conflicto) ---
PORT=3001

# --- Polling de pagos (en milisegundos) ---
# POLL_INTERVAL_MS=5000
# EMAIL_POLL_INTERVAL_MS=20000

# --- Email IMAP (opcional, para detectar nombres via correo) ---
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_IMAP_PORT=993
# EMAIL_IMAP_USER=tu-cuenta@gmail.com
# EMAIL_IMAP_PASSWORD=tu-app-password-gmail
# EMAIL_IMAP_MAILBOX=INBOX
# MERCADOPAGO_EMAIL_SENDER=mercadopago.com

# --- Debug (opcional) ---
# DEBUG_LOG_PAYMENTS=true
# DEBUG_LOG_EMAILS=true
# EMAIL_START_DATE=2025-01-01
