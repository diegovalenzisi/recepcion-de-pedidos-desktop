# ============================================================
# DLV Sistemas — Variables de entorno
# Copiá este archivo a ".env" y completá los valores reales.
# NUNCA subas el archivo .env a git.
# ============================================================

# --- Credenciales del usuario administrador ---
# Si no se definen, el sistema usa los valores por defecto del código.
VITE_ADMIN_USER=DiegoL
VITE_ADMIN_PASS=tu_contraseña_aqui

# --- Firebase API Keys por local ---
# Si no se definen, el sistema usa los valores por defecto del código.
# Reemplazá cada valor con la API key real del proyecto Firebase correspondiente.
VITE_API_KEY_DEFAULT=tu_api_key_default_aqui
VITE_API_KEY_TEMPERLEY=tu_api_key_temperley_aqui
VITE_API_KEY_CENTENARIO=tu_api_key_centenario_aqui
VITE_API_KEY_CANADA=tu_api_key_canada_aqui

# ============================================================
# IMPORTANTE: Mientras no configures este archivo .env,
# el sistema sigue funcionando igual que antes (usa fallbacks).
# Configurar el .env es el paso siguiente para mejorar seguridad.
# ============================================================
