{
  "name": "recepcion-de-pedidos-desktop",
  "type": "module",
  "version": "1.3.60",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host :: --port 3000",
    "test": "node electron/lib/__tests__/firebaseHttpTransport.test.js && node src/lib/cache/__tests__/clearSafeLocalCache.test.js && node src/lib/firebase/__tests__/firebaseAppPattern.test.js && node src/lib/firebase/__tests__/readiness.test.js && node src/lib/firebase/__tests__/multiLocalSwitch.test.js && node src/lib/firebase/__tests__/firebaseGeneration.test.js && node src/lib/firebase/__tests__/listenerCleanupOnSwitch.test.js && node electron/lib/__tests__/imageCacheService.test.js && node src/lib/cache/__tests__/articleImageController.test.js && node src/lib/api/__tests__/paridadCanonica.test.js && node src/lib/api/__tests__/contratoPrecios.test.js && node src/lib/api/__tests__/bloqueoPrecioInvalido.test.js && node src/lib/api/__tests__/opcionalesDepartamento.test.js && node src/lib/api/__tests__/validacionPedidoExterno.test.js && node src/lib/api/__tests__/paridadValidacionExterna.test.js && node src/lib/api/__tests__/sha256.test.js && node src/lib/api/__tests__/idsCanonicos.test.js && node src/lib/api/__tests__/stockAtomico.test.js && node src/lib/api/__tests__/stockLedger.test.js && node src/lib/api/__tests__/stockPlan.test.js && node src/lib/api/__tests__/stockImpactConectado.test.js && node src/lib/api/__tests__/fixturesComunes.test.js && node src/lib/api/__tests__/ordersIngest.test.js && node src/lib/api/__tests__/ingestaConectada.test.js && node src/lib/api/__tests__/optionalsPricing.test.js && node src/lib/api/__tests__/unidadesPedido.test.js && node src/lib/api/__tests__/ventaCostoGananciaOpcionales.test.js && node src/lib/print/__tests__/orderPrintDetail.test.js && node src/lib/print/__tests__/counterTicketIntegration.test.js",
    "test:stock-emulator": "firebase emulators:exec --only database --project stock-test --config emulator/firebase.json \"node src/lib/api/__tests__/stockEmulator.integration.mjs\"",
    "test:electron-runtime": "electron electron/lib/__tests__/electronRuntimeGlobals.cjs",
    "test:dlvimg-integration": "electron electron/lib/__tests__/dlvimgProtocol.integration.cjs",
    "build": "node tools/generate-llms.js & npx vite build",
    "preview": "vite preview --host :: --port 3000",
    "lint": "eslint . --quiet",
    "electron:dev": "concurrently --kill-others \"vite --host :: --port 3000\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "electron:preview": "cross-env NODE_ENV=production electron .",
    "electron:build": "npm run build && cd backend && npm install --omit=dev && cd .. && electron-builder",
    "desktop:setup-config": "node scripts/setup-desktop-config.js",
    "desktop:make-icon": "node scripts/png-to-ico.js",
    "prepare:dlv": "node scripts/prepare-dlv-files.js"
  },
  "build": {
    "appId": "com.heladeria.recepcion-pedidos-desktop",
    "productName": "Recepción de Pedidos",
    "copyright": "Copyright © 2025 Heladería",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/__tests__/**",
      "!electron/**/*.test.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!.env",
          "!.env.*",
          "!.gitignore",
          "!.nvmrc"
        ]
      },
      {
        "from": "resources/facturacion",
        "to": "facturacion",
        "filter": [
          "**/*",
          "!node_modules/**"
        ]
      },
      {
        "from": "build/icono-dlv.ico",
        "to": "build/icono-dlv.ico"
      }
    ],
    "asar": true,
    "icon": "build/icono-dlv.ico",
    "win": {
      "icon": "build/icono-dlv.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "sign": null,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Recepción de Pedidos",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "@emotion/is-prop-valid": "^1.2.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.0.3",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.5",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-pdf/renderer": "3.1.14",
    "@tanstack/react-query": "^5.28.4",
    "blob-to-base64": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "cmdk": "^0.2.0",
    "date-fns": "^3.6.0",
    "electron-pos-printer": "^1.3.7",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "firebase": "^10.7.1",
    "framer-motion": "^10.16.4",
    "input-otp": "^1.4.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.292.0",
    "next-themes": "^0.4.6",
    "qrcode.react": "^3.1.0",
    "react": "18.2.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "18.2.0",
    "react-helmet": "^6.1.0",
    "react-hook-form": "^7.72.1",
    "react-resizable-panels": "^4.9.0",
    "react-router-dom": "^6.24.0",
    "react-slick": "^0.30.2",
    "recharts": "^2.12.7",
    "slick-carousel": "^1.8.1",
    "sonner": "^2.0.7",
    "swr": "^2.2.5",
    "tailwind-merge": "^1.14.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^9.0.1",
    "vaul": "^1.1.2",
    "workbox-window": "^7.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.8.3",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.39.4",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.3",
    "vite": "^4.4.5",
    "wait-on": "^7.2.0"
  }
}
